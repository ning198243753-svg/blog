# ============================================================
# 环境变量示例
# 复制为 .env 后填写真实值。.env 不进仓库（ADR-10）。
# ============================================================

# ---- 应用 ----
DEBUG=false
LOG_LEVEL=INFO
SITE_URL=https://example.com

# ---- 数据库 ----
# 开发（Windows）：留空则使用 backend/data/db/blog.db
# 生产（容器内）：sqlite:////data/db/blog.db
DATABASE_URL=sqlite:///./data/db/blog.db

# ---- 会话密钥 ----
# 必须替换。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 这个值一旦泄露，任何人都能伪造登录 Cookie。
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48

SESSION_COOKIE_NAME=blog_session
SESSION_EXPIRE_DAYS=7
# 生产环境走 HTTPS 时必须为 true
COOKIE_SECURE=false

# ---- 管理员账号 ----
# 密码只从这里读取，不接受命令行参数
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 上传 ----
# 体积上限（MB）。文档 05 第 4.7 节规定默认 2MB。
# 不要因为「用户想传更大的图」就调高：ADR-02 选了本地存储，
# 图片流量全部压在自己的带宽上，调高上限等于让首屏变慢。
UPLOAD_MAX_SIZE_MB=2
# 长边超过该值则等比缩小。1600px 是文档 05 的取值，
# 对 3Mbps 带宽和主流屏幕（含 2x 屏）都够用。
UPLOAD_MAX_WIDTH=1600
# 上传目录。容器内应指向挂载的卷，例如 /data/uploads
# UPLOAD_DIR=/data/uploads
